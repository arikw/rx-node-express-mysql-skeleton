{
  "name": "rx-node-express-mysql-skeleton",
  "version": "1.0.0",
  "description": "Scaffold for Node.js Express REST API with MySQL",
  "author": "Arik W",
  "license": "ISC",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test:unit": "mocha tests/unit/ --recursive --require tests/global-fixtures/fixtures.cjs",
    "test:integration": "mocha tests/integration/ --recursive --require tests/global-fixtures/fixtures.cjs --timeout 30000",
    "test": "npm run test:unit && npm run test:integration",
    "coverage": "nyc npm run test",
    "lint:js": "node_modules/.bin/eslint --ext .js,.vue --ignore-path .eslintignore .",
    "lint": "npm run lint:js",
    "db:generate": "sequelize-cli migration:generate",
    "db:migrate": "sequelize-cli db:migrate",
    "db:undo": "sequelize-cli db:migrate:undo",
    "db:undo:all": "sequelize-cli db:migrate:undo:all"
  },
  "lint-staged": {
    "*.{js}": "node_modules/.bin/eslint"
  },
  "husky": {
    "hooks": {
      "pre-commit": "node_modules/.bin/lint-staged && npm run test:unit"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^5.2.5",
    "express-response-hooks": "^1.0.4",
    "express-validator": "^6.10.0",
    "helmet": "^4.1.1",
    "nodemon": "^3.1.10",
    "rx-mysql": "^2.0.0"
  },
  "devDependencies": {
    "axios-mock-adapter": "^1.20.0",
    "chai": "^4.5.0",
    "chai-http": "^5.1.2",
    "chai-json-schema": "^1.5.1",
    "decache": "^4.6.1",
    "deep-equal-in-any-order": "^1.1.15",
    "eslint": "^8.10.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-security": "^1.4.0",
    "husky": "^4.3.8",
    "jsdoc": "^4.0.2",
    "lint-staged": "^10.5.4",
    "mocha": "^11.7.2",
    "mock-require": "^3.0.3",
    "nyc": "^15.1.0",
    "sequelize": "^6.16.1",
    "sequelize-cli": "^6.4.1",
    "sinon": "^9.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
